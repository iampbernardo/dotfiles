#!/usr/bin/env bash

# Tokyo Night Storm
BG="0xff24283b"
FG="0xffc0caf5"
BLUE="0xff7aa2f7"
PURPLE="0xffbb9af7"
GREEN="0xff9ece6a"

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

sketchybar --bar \
  height=32 \
  color=$BG \
  border_width=0 \
  padding_left=8 \
  padding_right=8 \
  blur_radius=20 \
  position=top

sketchybar --default \
  icon.font="JetBrainsMono Nerd Font:Bold:14.0" \
  icon.color=$FG \
  label.font="JetBrainsMono Nerd Font:Semibold:13.0" \
  label.color=$FG \
  padding_left=4 \
  padding_right=4 \
  background.height=26 \
  background.corner_radius=6

# --- App activa ---------------------------------------------------------
sketchybar --add item front_app left \
  --set front_app \
    icon.drawing=off \
    label.color=$PURPLE \
    script="$PLUGIN_DIR/front_app.sh" \
  --subscribe front_app front_app_switched

# --- Reloj (centro) ------------------------------------------------------
sketchybar --add item clock center \
  --set clock \
    update_freq=10 \
    icon= \
    icon.color=$BLUE \
    script="$PLUGIN_DIR/clock.sh"

# --- Batería (derecha) ----------------------------------------------------
sketchybar --add item battery right \
  --set battery \
    update_freq=60 \
    icon.color=$GREEN \
    script="$PLUGIN_DIR/battery.sh" \
  --subscribe battery system_woke power_source_change

sketchybar --update
