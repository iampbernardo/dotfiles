[user]
	name = Pablo Bernardo
	email = iam@pbernardo.com
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = Nord
[merge]
	conflictstyle = diff3
[diff]
	colorMoved = default
[init]
	defaultBranchName = main
	defaultBranch = main
