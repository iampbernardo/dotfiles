{
  "name": "NOSTROMO",
  "version": "MK.II",
  "description": "Amber and cyan spacecraft command-console design language.",
  "colors": {
    "background": "#0b1012",
    "surface": "#131d21",
    "surfaceActive": "#1b2b30",
    "selection": "#30494c",
    "rail": "#263d43",
    "border": "#526970",
    "muted": "#71858a",
    "foreground": "#ddd3b8",
    "foregroundBright": "#f5edda",
    "amber": "#e9ae55",
    "amberBright": "#ffd58a",
    "cyan": "#78c7c4",
    "cyanBright": "#a2e5df",
    "success": "#9fbc85",
    "danger": "#f07167",
    "dangerBright": "#ff9385",
    "blue": "#719fae",
    "violet": "#b69ac7"
  },
  "ansi": {
    "0": "#131d21",
    "1": "#f07167",
    "2": "#9fbc85",
    "3": "#e9ae55",
    "4": "#719fae",
    "5": "#b69ac7",
    "6": "#78c7c4",
    "7": "#ddd3b8",
    "8": "#71858a",
    "9": "#ff9385",
    "10": "#bed69b",
    "11": "#ffd58a",
    "12": "#9cc5d3",
    "13": "#d1b3e0",
    "14": "#a2e5df",
    "15": "#f5edda"
  },
  "typography": {
    "mono": "JetBrainsMono Nerd Font Mono",
    "fallback": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "terminalFontSizePt": 14,
    "terminalCellHeightAdjustmentPercent": 10
  },
  "terminal": {
    "paddingX": 20,
    "paddingY": 14,
    "backgroundOpacity": 1,
    "unfocusedSplitOpacity": 0.85,
    "cursor": "amber block"
  },
  "motion": {
    "ambientAnimation": false,
    "cursorBlink": true
  }
}
